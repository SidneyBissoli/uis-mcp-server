                "type"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "has_more": {
            "type": "boolean"
          },
          "next_offset": {
            "type": "number"
          },
          "offset": {
            "type": "number"
          },
          "provenance": {},
          "showing": {
            "type": "number"
          },
          "total_matches": {
            "type": "number"
          }
        },
        "required": [
