{"name":"uis-mcp-server","version":"1.0.0","mcpName":"io.github.SidneyBissoli/uis-mcp-server","license":"MIT","description":"Remote MCP server for the UNESCO Institute for Statistics (UIS): ~5,000 indicators on education, science/R&D, culture and communication by country, region and year — hosted, nothing to install, no API key, with source URL, data release, retrieval timestamp and licence on every answer. Everyday and US wording (enrollment, spending, preschool) is resolved to the UIS's own. Also runs locally over stdio.","homepage":"https://uis.sidneybissoli.com","repository":{"type":"git","url":"git+https://github.com/SidneyBissoli/uis-mcp-server.git"},"bugs":{"url":"https://github.com/SidneyBissoli/uis-mcp-server/issues"},"author":"Sidney da S. P. Bissoli <sbissoli76@gmail.com>","keywords":["mcp","model-context-protocol","mcp-server","remote-mcp-server","unesco","uis","education-statistics","education","literacy","enrolment","sdg4","research-and-development","science-statistics","culture-statistics","official-statistics","open-data","provenance"],"engines":{"node":">=22"},"type":"module","bin":{"uis-mcp-server":"dist/cli.js"},"files":["dist","README.md","LICENSE.md"],"scripts":{"version":"node scripts/sync-version.mjs && git add -u","dev":"wrangler dev","build":"tsc -p tsconfig.build.json","start":"node dist/cli.js","deploy":"wrangler deploy","typecheck":"tsc --noEmit","test":"vitest run","seed:sql":"node scripts/seed-uis-catalog.mjs","eval":"tsx evals/run.ts"},"dependencies":{"@modelcontextprotocol/server":"^2.0.0","@sbissoli/mcp-provenance":"^0.1.0","@sbissoli/mcp-search":"^0.6.0","zod":"^4.6.5"},"devDependencies":{"@cloudflare/workers-types":"^5.20260918.1","@modelcontextprotocol/client":"^2.0.0","@sbissoli/mcp-evals":"^0.1.0","@types/node":"^26.6.1","agents":"^0.23.0","tsx":"^4.23.13","typescript":"^7.0.2","vite":"^8.3.0","vitest":"^5.0.1","wrangler":"^4.134.0"},"overrides":{"sharp":"^0.35.4"}}